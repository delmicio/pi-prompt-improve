{
  "name": "pi-prompt-improve",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delmicio/pi-prompt-improve.git"
  },
  "homepage": "https://github.com/delmicio/pi-prompt-improve#readme",
  "bugs": {
    "url": "https://github.com/delmicio/pi-prompt-improve/issues"
  },
  "type": "module",
  "description": "Pi extension for improving unsent editor drafts without submitting them",
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompt",
    "prompt-improvement"
  ],
  "files": [
    "src",
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run smoke"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@types/node": "^22.15.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
